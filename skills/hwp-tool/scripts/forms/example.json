  "보기 표": {"세로": [4, 2], "가로": [2, 4], "가로로 둘 보기 글자 수": 9},
  "보기 기호": "①②③④",
  "상자 표": {"크기": [3, 3], "제목 칸": [1, 0], "제목": "보기", "글 칸": [0, 2]},
  "과목 띠": "제\\s*(\\d)\\s*과목",
  "과목 문항 수": [4, 5],
  "문항 간격 pt": 16,
  "쪽수 표기": {"표지": "제외한 (\\d+)면", "쪽 아래": "^총 (\\d+)쪽$", "본문 밖 쪽": 1},
  "자간 한도": {"줄이기": 10, "늘리기": 10},
  "단 아래 허용 mm": 3,
  "표지 바꿀 글": [["2026년 ○월 ○일", "2026년 3월 1일"]]
}
